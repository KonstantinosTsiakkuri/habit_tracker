# Скопируйте этот файл в .env и подставьте свои значения: cp .env.template .env

# --- Django ---
# Секретный ключ. Сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
# Режим отладки: True только для разработки
DEBUG=True
# Разрешённые хосты через запятую
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DB_NAME=habit_tracker
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Telegram-бот ---
# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_API_URL=https://api.telegram.org

# --- CORS / CSRF ---
# Домены фронтенда через запятую (со схемой, без слэша в конце).
# CORS_ALLOWED_ORIGINS — откуда браузеру разрешено обращаться к API;
# CSRF_TRUSTED_ORIGINS — каким доменам доверяет CSRF-защита Django (админка, cookie).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
